{
  "name": "language-learning-platform",
  "version": "1.0.0",
  "license": "MIT",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/start-api.js",
    "start": "node scripts/start-api.js",
    "start:hidden": "powershell -ExecutionPolicy Bypass -File scripts/start-hidden.ps1",
    "start:prod": "node scripts/start-api.js --prod",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "electron:dev": "electron .",
    "electron:full": "concurrently -k \"npm run dev\" \"npm run dev:api\" \"node -e setTimeout(()=>require('child_process').spawn('npx',['electron'],{stdio:'inherit',shell:true}),3000)\"",
    "electron:build": "npm run build && electron-builder",
    "build": "tsc && vite build && npm run verify:build && npm run security:sign-build",
    "verify:build": "node scripts/verify-build-security.js",
    "security:sbom": "node -e \"import('./api/security/supplychain/sbom.js').then(m=>m.generateSbom().then(r=>{console.log(JSON.stringify(r,null,2))}))\"",
    "security:verify-deps": "node -e \"import('./api/security/supplychain/dependencyVerifier.js').then(m=>m.verifyDependencies().then(r=>{console.log(JSON.stringify(r,null,2));process.exit(r.passed?0:1)}))\"",
    "security:sign-build": "node -e \"import('./api/security/supplychain/buildSigner.js').then(m=>m.signBuild().then(r=>{console.log(JSON.stringify(r,null,2))}))\"",
    "security:verify-build-signature": "node scripts/verify-build-signature.js",
    "security:regression-test": "node scripts/security-regression-tests.js",
    "security:all": "npm run security:verify-deps && npm run security:regression-test",
    "preview": "vite preview",
    "waf:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-caddy-coraza.ps1",
    "waf:start": "powershell -ExecutionPolicy Bypass -File scripts/start-waf.ps1",
    "waf:test": "node scripts/test-caddy-waf.js",
    "security:gen-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "security:encrypt-files": "node scripts/migrate-to-encrypted-storage.js",
    "security:protect-file-vault-key": "node scripts/protect-vault-key.js",
    "protect:file-vault-key": "node scripts/protect-vault-key.js",
    "security:rotate-file-key": "node scripts/rotate-file-encryption-key.js",
    "security:verify-encryption": "node -e \"import('./api/security/vault/keyRotationEngine.js').then(m=>m.verifyEncryptionIntegrity().then(r=>{console.log(JSON.stringify(r,null,2));process.exit(r.some(i=>!i.ok)?1:0)}))\"",
    "security:recovery-drill": "node scripts/security-recovery-drill.js",
    "setup:keys": "node scripts/setup-dev-keys.js",
    "logs": "node scripts/view-logs.js",
    "logs:follow": "node scripts/view-logs.js -f",
    "secure:env": "node scripts/secure-env.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "trigger-update": "node scripts/trigger-update.js",
    "hot-update": "node scripts/trigger-update.js",
    "test": "vitest run",
    "test:frontend": "vitest run --config vitest.config.ts",
    "test:backend": "vitest run --config api/vitest.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "build": {
    "appId": "com.lingualeap.app",
    "productName": "LinguaLeap",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "api/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/rapier": "^1.5.0",
    "@sentry/node": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "framer-motion": "^12.38.0",
    "geoip-lite": "^1.4.10",
    "gsap": "^3.15.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.330.0",
    "meshline": "^3.3.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "qrcode.react": "^4.2.0",
    "rate-limit-redis": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.10.4",
    "redis": "^6.0.0",
    "speakeasy": "^2.0.0",
    "sql.js": "^1.14.1",
    "svg-captcha": "^1.4.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "vite-plugin-compression": "^0.5.1",
    "zod": "^4.4.3",
    "zustand": "^4.5.0"
  },
  "overrides": {
    "shell-quote": "^1.8.4",
    "undici": "^7.28.0",
    "@babel/core": "^7.29.7",
    "js-yaml": "^4.2.0",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^42.1.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "javascript-obfuscator": "^5.4.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "terser": "^5.48.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
