# ============================================
# LinguaLeap — 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入真实值
# 警告：.env 严禁提交到版本控制系统！
# ============================================

# 后端服务端口
PORT=3001
# 服务绑定地址：开发环境必须绑定 127.0.0.1，生产环境如需外网访问请通过反向代理
HOST=127.0.0.1

# ===== JWT 密钥（必填） =====
# 生成方法：node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=你的JWT签名密钥（至少32位十六进制）
JWT_REFRESH_SECRET=你的JWT刷新令牌密钥（至少32位十六进制）

# ===== 智谱AI API（可选） =====
# 用于AI对话、Bug分析等功能
# 申请地址：https://open.bigmodel.cn/
ZHIPUAI_API_KEY=你的智谱AI API密钥

# ===== 管理员密码（重要） =====
# 不设置时将自动生成随机密码并打印到控制台
# 首次启动后请立即登录修改密码
ADMIN_PASSWORD=你的管理员密码（至少12位，含大小写字母+数字+特殊字符）

# ===== 运行环境 =====
# development | production | test
NODE_ENV=development

# ===== 跨域白名单 =====
# 允许的前端地址（逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# ===== Redis / 状态持久化 =====
# REDIS_ENABLED: 是否启用 Redis（默认 true）；设为 false 时所有功能回退到内存/文件
# RATE_LIMIT_STORE: memory（默认，单机/开发）或 redis（生产/多实例）
# REDIS_URL: Redis 连接地址，生产环境建议带认证，如 redis://user:pass@host:6379
REDIS_ENABLED=true
RATE_LIMIT_STORE=memory
REDIS_URL=redis://localhost:6379

# ===== 文件加密密钥（必填，生产环境） =====
# 用于加密落盘的用户数据、审计日志等敏感文件
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FILE_ENCRYPTION_KEY=你的32字节base64文件加密密钥

# ===== 管理员隐私字段独立加密密钥（必填，生产环境） =====
# 必须与 FILE_ENCRYPTION_KEY 不同，用于字段级加密 IP/User-Agent/设备名等
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_PRIVACY_KEY=你的32字节base64管理员隐私加密密钥

# ===== 支付签名密钥（必填，生产环境） =====
# 用于订单签名与防篡改校验
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_SECRET=你的32字节十六进制支付签名密钥

# ===== 审计日志 SQLite =====
# AUDIT_SQLITE_PATH: SQLite 审计日志文件路径（默认 data/audit-log.sqlite）
# AUDIT_SQLITE_SAVE_INTERVAL_MS: SQLite 落盘间隔（默认 30000ms）
AUDIT_SQLITE_PATH=data/audit-log.sqlite
AUDIT_SQLITE_SAVE_INTERVAL_MS=30000

# ===== 反向代理信任 =====
# TRUST_PROXY: 控制 Express 对 X-Forwarded-For 等代理头的信任
# 开发环境可设为 1；生产环境建议设为代理数量或具体 CIDR，如 'loopback, linklocal, uniquelocal'
TRUST_PROXY=1

# ===== HTTPS / TLS =====
# 生产环境配置 TLS 证书路径（使用 Caddy/Nginx/Node 直连均可）
# HTTPS_KEY=./certs/key.pem
# HTTPS_CERT=./certs/cert.pem

# ===== JWT Pepper 防护（自动，无需配置） =====
# 服务器启动时自动生成 32 字节随机 pepper（仅存内存，永不落盘）。
# pepper 嵌入每个 JWT 的 payload 中，验证时强制校验。
# 这意味着：即使 .env 泄露导致 JWT_SECRET 被攻击者获知，也无法伪造有效 Token。
# 副作用：服务器重启后所有旧 Token 失效（需重新登录）。

# ===== 安全注意事项 =====
# 1. 永远不要将 .env 文件提交到 Git
# 2. 生产环境务必使用强密码和密钥
# 3. 定期轮换 JWT_SECRET 和 JWT_REFRESH_SECRET
# 4. 不要在多环境之间共用密钥
# 5. 如怀疑密钥泄漏，立即修改并重启服务
# 6. 生产环境必须设置 NODE_ENV=production，并配置 HTTPS
# 7. 生产环境建议将 JWT_SECRET 等密钥设为系统环境变量，而非保存在 .env 文件中

# ===== AI 防御系统智能化开关 =====
# 开启增强型 AI 防御（总开关）
AI_ENHANCED_DEFENSE=true

# LLM 安全分析师
AI_LLM_ANALYST=true
AI_LLM_CONFIDENCE_LOW=0.4
AI_LLM_CONFIDENCE_HIGH=0.85

# 时序行为模型
AI_TEMPORAL_MODEL=true

# 自适应学习与规则进化
AI_ADAPTIVE_LEARNING=true
AI_RULE_EVOLUTION=true

# 本地威胁情报
AI_THREAT_INTEL=true

# 智能隔离
AI_SMART_ISOLATION=true
AI_PREDICTIVE_ISOLATION=true
AI_DYNAMIC_ISOLATION_POLICY=true
AI_SMART_RECOVERY=true

# 主动防御与欺骗
AI_ACTIVE_DEFENSE=true
AI_HONEYPOT_DYNAMIC=true
AI_DECEPTION_RESPONSE=true
AI_AUTO_ISOLATION_LINK=true

# 外部威胁情报（ AbuseIPDB / FireHOL / IPinfo / ip-api.com ）
AI_EXTERNAL_THREAT_INTEL=true
ABUSEIPDB_API_KEY=
IPINFO_TOKEN=
THREAT_INTEL_CACHE_TTL_SECONDS=3600

# Tarpit 延迟（主动防御对重复攻击者递增响应延迟）
AI_TARPIT_ENABLED=true

# ===== 应用层 WAF 规则层（SQLi / XSS / LFI / 命令注入 / SSRF / XXE） =====
WAF_RULES_ENABLED=true

# ===== 前置 Caddy + Coraza WAF =====
# 测试脚本访问地址（默认 https://localhost:3443）
WAF_BASE_URL=https://localhost:3443